CREATE TABLE discovery_hidden (
    media_type TEXT NOT NULL,
    clean_title TEXT NOT NULL,
    hidden_at INTEGER NOT NULL,
    PRIMARY KEY (media_type, clean_title)
);

selectAllByMedia:
SELECT * FROM discovery_hidden WHERE media_type = ?;

insertOrIgnore:
INSERT OR IGNORE INTO discovery_hidden(media_type, clean_title, hidden_at) VALUES (?, ?, ?);

delete:
DELETE FROM discovery_hidden WHERE media_type = ? AND clean_title = ?;

deleteAllByMedia:
DELETE FROM discovery_hidden WHERE media_type = ?;
